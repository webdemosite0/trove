# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Required. https://aistudio.google.com/apikey
# The free tier allows 20 requests per day per model; enable billing for real use.
GEMINI_API_KEY=

# Optional. Pins the first model tried; the fallback chain handles the rest.
# GEMINI_MODEL=gemini-3.5-flash

# Canonical URLs, the sitemap, the OG image, OAuth redirects and Stripe
# return URLs all derive from this.
SITE_URL=

# Public wildcard domain used by user-published sites.
# For a global launch, use a SEPARATE registrable domain from the authenticated
# Trove app (for example trove.page rather than *.troveai.site) so arbitrary
# user HTML/JS does not share the app's browser site boundary.
NEXT_PUBLIC_PUBLISH_ROOT_DOMAIN=

# Reserved for future server-side signing/encryption. Current sessions use
# random opaque tokens stored as hashes in the database, so this is not required.
TROVE_SECRET=

# Turso (libSQL) — credits, users, conversations and published-site claims
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email (Resend or SMTP)
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Production password signup requires working email verification. Set this only
# for a disposable demo/preview where unverified password accounts are acceptable.
TROVE_ALLOW_UNVERIFIED_PASSWORD_SIGNUP=0

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allow ephemeral sessions without full auth (dev only)
TROVE_ALLOW_EPHEMERAL=

# ── Experiential Labs (OpenAI-compatible gateway) ───────────────────────────
# https://platform.experientiallabs.ai/settings
# Prefer this for chat + builder when set. Never commit the real key.
EXPLABS_API_KEY=
# Optional model id from GET /v1/models (default: qwen3.8-27b)
EXPLABS_MODEL=qwen3.8-27b

# OpenAI-compatible fallbacks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
XAI_API_KEY=
XAI_MODEL=
PUTER_AUTH_TOKEN=
PUTER_MODEL=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_YEARLY=

# Lemon Squeezy (preferred merchant-of-record option for global billing)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_TEAM=
LEMONSQUEEZY_VARIANT_TEAM_YEARLY=

# Keep Team checkout disabled until organization membership, invitations, roles,
# and shared workspace permissions are implemented and tested.
TROVE_TEAM_WORKSPACES_ENABLED=0

# Search
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Sites Preview runs in reusable E2B sandboxes.
# Keep this server-side only; never expose it with NEXT_PUBLIC_.
E2B_API_KEY=

# Arbitrary project terminal execution is OFF by default for launch safety.
# Set to 1 only if you intentionally want to expose the sandbox terminal.
TROVE_SANDBOX_TERMINAL_ENABLED=0

# Optional production operations alert webhook.
# Supports Slack-compatible webhooks and Discord webhooks. Keep server-side only.
TROVE_ALERT_WEBHOOK_URL=
