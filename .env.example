# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Required. https://aistudio.google.com/apikey
# The free tier allows 20 requests per day per model; enable billing for real use.
GEMINI_API_KEY=

# Optional. Pins the first model tried; the fallback chain handles the rest.
# GEMINI_MODEL=gemini-3.5-flash

# Canonical URLs, the sitemap, the OG image, OAuth redirects and Stripe
# return URLs all derive from this.
SITE_URL=

# Required for session cookies / encryption.
#   openssl rand -base64 32
TROVE_SECRET=

# Turso (libSQL) — credits, users, conversations
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email (Resend or SMTP)
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allow ephemeral sessions without full auth (dev only)
TROVE_ALLOW_EPHEMERAL=

# ── Experiential Labs (OpenAI-compatible gateway) ───────────────────────────
# https://platform.experientiallabs.ai/settings
# Prefer this for chat + builder when set. Never commit the real key.
EXPLABS_API_KEY=
# Optional model id from GET /v1/models (default: qwen3.8-27b)
EXPLABS_MODEL=qwen3.8-27b

# OpenAI-compatible fallbacks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
XAI_API_KEY=
XAI_MODEL=
PUTER_AUTH_TOKEN=
PUTER_MODEL=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Search
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# E2B sandbox for Sites preview
E2B_API_KEY=
