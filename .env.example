# Copy to .env.local for local dev. On Vercel, set the same names in Project → Settings → Environment Variables.
# Never commit real secrets.

# ── Experiential Labs (OpenAI-compatible gateway) ───────────────────────────
# https://platform.experientiallabs.ai/settings
# Prefer this for chat + builder when set. Never commit the real key.
EXPLABS_API_KEY=
# Optional model id from GET /v1/models (default: qwen3.8-27b)
EXPLABS_MODEL=qwen3.8-27b
